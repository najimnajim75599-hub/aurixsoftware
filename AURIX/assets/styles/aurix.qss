/* AURIX theme: Obsidian #080808, Dark Crimson #780D18, Signal Red #C51F32,
   Titanium #C5C5C5, White #FFFFFF */
* { font-family: "Segoe UI", "Inter", sans-serif; font-size: 10pt; }

QMainWindow, QWidget#Content, QWidget#Page { background: #FFFFFF; color: #080808; }

/* ---- Sidebar ---- */
QFrame#Sidebar { background: #080808; }
QLabel#BrandWord { color: #FFFFFF; font-size: 17pt; font-weight: 700; letter-spacing: 4px; }
QLabel#BrandTag  { color: #C5C5C5; font-size: 8pt; }
QLabel#SidebarFooter { color: #7A7A7A; font-size: 8pt; }
QFrame#SidebarDivider { background: #1E1E1E; max-height: 1px; min-height: 1px; }

QPushButton#NavButton {
    color: #C5C5C5; background: transparent; border: none; border-radius: 8px;
    text-align: left; padding: 10px 14px; font-size: 10.5pt;
}
QPushButton#NavButton:hover   { background: #1A1A1A; color: #FFFFFF; }
QPushButton#NavButton:checked { background: #C51F32; color: #FFFFFF; font-weight: 600; }
QPushButton#NavButton:pressed { background: #780D18; }

/* ---- Page text ---- */
QLabel#PageTitle    { font-size: 22pt; font-weight: 700; color: #080808; }
QLabel#PageSubtitle { font-size: 10.5pt; color: #6B6B6B; }

/* ---- Cards ---- */
QFrame#Card { background: #FFFFFF; border: 1px solid #E4E4E4; border-radius: 10px; }
QLabel#CardTitle { font-size: 11.5pt; font-weight: 600; color: #080808; }
QLabel#CardText  { color: #6B6B6B; }
QLabel#StatValue { font-size: 20pt; font-weight: 700; color: #C51F32; }
QLabel#StatLabel { color: #6B6B6B; font-size: 9pt; }
QLabel#Badge {
    background: #FBE9EB; color: #780D18; border-radius: 9px;
    padding: 3px 10px; font-size: 8.5pt; font-weight: 600;
}

/* ---- Buttons ---- */
QPushButton#Primary {
    background: #C51F32; color: #FFFFFF; border: none; border-radius: 8px;
    padding: 9px 18px; font-weight: 600;
}
QPushButton#Primary:hover   { background: #A8192A; }
QPushButton#Primary:pressed { background: #780D18; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #C5C5C5; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---- Phase 2-4 additions ---- */
QWidget#PageContent { background: #FFFFFF; }
QScrollArea { border: none; background: #FFFFFF; }
QScrollArea > QWidget > QWidget { background: #FFFFFF; }

QLineEdit, QPlainTextEdit, QComboBox {
    border: 1px solid #D9D9D9; border-radius: 8px; padding: 8px 10px;
    background: #FFFFFF; color: #080808; selection-background-color: #C51F32;
}
QLineEdit#SearchBar { background: #F6F6F6; padding: 11px 12px; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid #C51F32; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { border: 1px solid #D9D9D9; selection-background-color: #FBE9EB; selection-color: #080808; }

QFrame#Tile { background: #FFFFFF; border: 1px solid #E4E4E4; border-radius: 10px; }
QFrame#Tile:hover { border: 1px solid #C51F32; background: #FFF7F8; }
QLabel#TileTitle { font-weight: 600; font-size: 11pt; }
QFrame#Row { border-bottom: 1px solid #F0F0F0; }
QFrame#Row:hover { background: #FAFAFA; }
QLabel#RowTitle { font-weight: 600; }
QLabel#RowSub { color: #6B6B6B; font-size: 9pt; }

QPushButton { border: 1px solid #D9D9D9; border-radius: 8px; padding: 8px 14px; background: #FFFFFF; color: #080808; }
QPushButton:hover { border-color: #C51F32; color: #C51F32; }
QPushButton:pressed { background: #FBE9EB; }
QPushButton:disabled { color: #A8A8A8; border-color: #EBEBEB; background: #FAFAFA; }
QPushButton#Primary { background: #C51F32; color: #FFFFFF; border: none; }
QPushButton#Primary:hover { background: #A8192A; color: #FFFFFF; }
QPushButton#Primary:disabled { background: #E5A3AB; color: #FFFFFF; }
QPushButton#Danger { color: #780D18; }
QPushButton#Danger:hover { background: #780D18; color: #FFFFFF; border-color: #780D18; }
QPushButton#Chip { border-radius: 14px; padding: 5px 12px; }
QPushButton#Chip:checked { background: #C51F32; color: #FFFFFF; border-color: #C51F32; }

QListWidget#ItemList { border: 1px solid #E4E4E4; border-radius: 10px; padding: 4px; outline: none; }
QListWidget#ItemList::item { padding: 9px 10px; border-radius: 8px; }
QListWidget#ItemList::item:hover { background: #F6F6F6; }
QListWidget#ItemList::item:selected { background: #FBE9EB; color: #080808; }

QStatusBar { background: #F6F6F6; color: #080808; border-top: 1px solid #E4E4E4; }
QMessageBox { background: #FFFFFF; }

/* ---- Phase 5-8 additions ---- */
QTabWidget::pane { border: 1px solid #E4E4E4; border-radius: 8px; top: -1px; background: #FFFFFF; }
QTabBar::tab { padding: 8px 16px; border: none; color: #6B6B6B; background: transparent; margin-right: 2px; }
QTabBar::tab:hover { color: #C51F32; }
QTabBar::tab:selected { color: #080808; font-weight: 600; border-bottom: 2px solid #C51F32; }

QProgressBar { border: 1px solid #E4E4E4; border-radius: 8px; background: #F6F6F6; text-align: center; height: 20px; color: #080808; }
QProgressBar::chunk { background: #C51F32; border-radius: 7px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #BDBDBD; border-radius: 4px; background: #FFFFFF; }
QCheckBox::indicator:checked { background: #C51F32; border-color: #C51F32; }

QGraphicsView#Graph { border: 1px solid #E4E4E4; border-radius: 10px; }
QDialog { background: #FFFFFF; }
QInputDialog, QMessageBox { background: #FFFFFF; }
QToolTip { background: #080808; color: #FFFFFF; border: none; padding: 4px 8px; }
